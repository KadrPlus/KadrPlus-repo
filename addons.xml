<?xml version="1.0" encoding="UTF-8"?>
<addons>
    <addon id="repository.kadrplus" name="KadrPlus Repository" version="1.0.2" provider-name="Kadr+">
        <extension point="xbmc.addon.repository" name="KadrPlus Repository">
            <dir minversion="21.0.0">
                <info compressed="false">https://raw.githubusercontent.com/KadrPlus/KadrPlus-repo/main/addons.xml</info>
                <checksum>https://raw.githubusercontent.com/KadrPlus/KadrPlus-repo/main/addons.xml.md5</checksum>
                <datadir zip="true">https://raw.githubusercontent.com/KadrPlus/KadrPlus-repo/main/zips/</datadir>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="pl">Oficjalne repozytorium Kadr+</summary>
            <summary lang="de">Offizielles Repository für Kadr+</summary>
            <summary lang="en">Official repository for Kadr+</summary>
            <description lang="pl">Oficjalne repozytorium Kadr+. Zawiera wtyczkę Kadr+ — filmy i seriale.</description>
            <description lang="de">Offizielles Kadr+ Repository. Enthält Kadr+ — das Kodi-Addon für Filme und Serien.</description>
            <description lang="en">Official Kadr+ repository. Contains Kadr+ — movies and TV shows addon.</description>
            <assets>
                <icon>icon.png</icon>
            </assets>
        </extension>
    </addon>
    <addon id="plugin.video.kadrplus2" name="Kadr+ 2.0" version="2.0.61" provider-name="FanFilm, divoff">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
            <import addon="script.module.requests" />
            <import addon="script.module.urllib3" />
            <import addon="script.module.future" />
            <import addon="plugin.video.youtube" optional="true" />
            <import addon="script.module.pyxbmct" />
            <import addon="script.module.resolveurl" />
            <import addon="script.module.inputstreamhelper" />
            <import addon="script.module.myconnpy" />
            <import addon="script.module.pil" version="5.1.0" />
            <import addon="service.upnext" optional="true" />
        </requires>
        <extension point="xbmc.python.pluginsource" library="default.py">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.service" library="service.py" start="startup" />
        <extension point="kodi.context.item">
            <menu id="kodi.core.main">
                <item library="extsearch.py">
                    <label lang="pl">Szukaj w Kadr+ 2.0</label>
                    <visible>String.StartsWith(ListItem.FolderPath,pvr://) + !String.IsEmpty(ListItem.ChannelName)</visible>
                </item>
            </menu>
        </extension>
        <extension point="xbmc.addon.metadata">
            <reuselanguageinvoker>true</reuselanguageinvoker>
            <summary lang="pl">Kadr+ 2.0 - nowa generacja dodatku</summary>
            <description lang="pl">Kadr+ 2.0 - nowa wersja dodatku rozwijana przez divoff, oparta na nowszym silniku FanFilm.[CR]Kontakt do twórcy modyfikacji - t.me/div0ff</description>
            <platform>all</platform>
            <license>GPL-3.0-or-later</license>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>
</addons>
